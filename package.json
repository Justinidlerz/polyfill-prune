{
  "name": "@polyfill-prune/core",
  "version": "0.1.1",
  "description": "Rust and Oxc powered removal of obsolete JavaScript polyfill branches",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.20.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "licenses",
    "docs"
  ],
  "scripts": {
    "build:native": "node scripts/build-native.mjs",
    "build:ts": "tsc -p tsconfig.json",
    "build:plugin": "pnpm --filter @polyfill-prune/vite-plugin build",
    "build:js": "pnpm build:ts && pnpm build:plugin",
    "build": "node scripts/clean-dist.mjs && pnpm build:native && pnpm build:js",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm --filter @polyfill-prune/vite-plugin typecheck",
    "check:rust": "cargo check --locked --workspace && cargo clippy --locked --workspace -- -D warnings",
    "check:scripts": "node scripts/check-scripts.mjs",
    "prepack": "pnpm build",
    "example": "node examples/prune.mjs",
    "example:vite": "vite build --config examples/vite/vite.config.mjs",
    "format": "prettier --write src scripts examples packages README.md docs .github .changeset package.json tsconfig.json npm pnpm-workspace.yaml",
    "format:check": "prettier --check src scripts examples packages README.md docs .github .changeset package.json tsconfig.json npm pnpm-workspace.yaml",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version:packages": "changeset version && node scripts/sync-native-version.mjs && node scripts/sync-platform-packages.mjs",
    "platforms:sync": "node scripts/sync-platform-packages.mjs",
    "pack:release": "node scripts/pack-ci.mjs",
    "data:sync": "cargo run --locked -p polyfill_prune_core --bin sync-compat -- node_modules/@mdn/browser-compat-data node_modules/typescript native/data/compat.json"
  },
  "devDependencies": {
    "@polyfill-prune/vite-plugin": "workspace:*",
    "@changesets/cli": "3.0.3",
    "@napi-rs/cli": "3.10.8",
    "@types/node": "^22.19.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "@polyfill-prune/example-vendor": "file:examples/vendor",
    "@mdn/browser-compat-data": "8.1.8"
  },
  "napi": {
    "binaryName": "polyfill-prune",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  },
  "optionalDependencies": {
    "@polyfill-prune/core-darwin-arm64": "workspace:*",
    "@polyfill-prune/core-darwin-x64": "workspace:*",
    "@polyfill-prune/core-linux-arm64-gnu": "workspace:*",
    "@polyfill-prune/core-linux-x64-gnu": "workspace:*",
    "@polyfill-prune/core-win32-x64-msvc": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Justinidlerz/polyfill-prune.git"
  }
}
